{
  "name": "molinova",
  "private": true,
  "productName": "Molinova",
  "version": "0.1.0",
  "description": "Open-source personal and family assistant for macOS: triages Gmail, reads WhatsApp locally, keeps a family calendar and tasks, files your Google Drive documents, answers on Telegram, with AI through the Vercel AI Gateway.",
  "license": "MIT",
  "author": "Kasiopa SAS",
  "homepage": "https://github.com/kasiopajg/molinova",
  "bugs": {
    "url": "https://github.com/kasiopajg/molinova/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kasiopajg/molinova.git"
  },
  "type": "module",
  "main": "dist-desktop/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "scripts": {
    "ea": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "test": "vitest run",
    "ui": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts --no-open",
    "i18n": "tsx scripts/i18n-check.ts",
    "build": "node -e \"for (const d of ['dist', 'dist-desktop']) require('fs').rmSync(d, { recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc -p tsconfig.desktop.json",
    "native:electron": "node scripts/native-electron.mjs",
    "native:text": "sh scripts/native-text.sh",
    "icons": "sh scripts/make-icons.sh",
    "app:dev": "pnpm build && pnpm native:electron && pnpm native:text && electron .",
    "app:dist": "pnpm build && pnpm native:electron && pnpm native:text && electron-builder --mac dmg --arm64 --publish never",
    "app:cert": "sh scripts/make-signing-cert.sh",
    "app:install": "sh scripts/install-local.sh"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.90",
    "ai": "^7.0.112",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "google-auth-library": "^11.1.0",
    "googleapis": "^181.0.0",
    "open": "^10.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
