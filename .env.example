# Molinova — development configuration.
# Copy this file to .env.local (never committed) and fill in the values you need.
# In the macOS app you do not need this file: the setup assistant asks for these values
# and stores them encrypted in the macOS Keychain (Electron safeStorage), see docs/desktop-app.md.
# Variables already set in the environment always win over this file.

# Vercel AI Gateway API key (required for the AI features).
AI_GATEWAY_API_KEY=

# Google OAuth client, "Desktop app" type (required to connect Gmail / Google Calendar).
# Legacy alternative: the downloaded JSON file saved as credentials/google-oauth.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Telegram bot token from @BotFather (can also be pasted in the app, Channels > Telegram).
TELEGRAM_BOT_TOKEN=

# Development only, optional. Set them in your shell rather than here: .env.local is read
# from the data folder, so MOLINOVA_HOME cannot be chosen from inside it.
# MOLINOVA_HOME  = data folder (config/, data/, tokens/, credentials/, logs/, .env.local). Default: the repository.
#              Point it to a throwaway folder to test without touching your real data.
# MOLINOVA_PORT  = port of the local server. Default: 4310.
